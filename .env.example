APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ludoverse
DB_USERNAME=ludoverse
DB_PASSWORD=your_db_password_here

SESSION_DRIVER=database
# 30-minute inactivity timeout for user sessions.
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies are HttpOnly by default (see SESSION_HTTP_ONLY in config/session.php).
# Keep SameSite=lax so top-level navigation logins keep working.
SESSION_SAME_SITE=lax
# Local dev runs over plain HTTP, so the cookie must NOT require HTTPS here.
# In production (HTTPS), set this to true so the session cookie is only
# ever sent over a secure connection.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: "log" writes emails to the log file instead of sending them.
# Production: switch to "smtp" and fill in the credentials below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Password for the seeded admin user (admin@ludoverse.local).
# Set a strong value before running the seeders in production.
ADMIN_SEED_PASSWORD=ChangeMe123!

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Razorpay payment gateway credentials (App\Services\Payments\RazorpayGateway).
# Keys come ONLY from here; the admin settings page just toggles the gateway on/off.
# Get live/test keys from https://dashboard.razorpay.com/app/keys — never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Broadcasting (Laravel Reverb — live match events on private match.{id} channels).
# Run the server with: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
